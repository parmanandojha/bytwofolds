# Inquiries are POSTed here as JSON (Zapier, Make, Slack workflow, your CRM)
INQUIRY_WEBHOOK_URL=
# Inquiries are emailed here. SMTP defaults to Gmail; SMTP_PASS is a Google App Password, not your login password
INQUIRY_EMAIL_TO=
SMTP_USER=
SMTP_PASS=
# Optional, for another mail provider
SMTP_HOST=
SMTP_PORT=
# Optional: Claude-written chat answers (server only)
ANTHROPIC_API_KEY=
